  m_Script: {fileID: 11500000, guid: d17792f9694eb0549904178501044064, type: 3}
  m_Name: Ione
  m_EditorClassIdentifier: 
  npcName: Ione
  ingredientIcon: {fileID: 21300000, guid: b4853f6eb0639c34797b667f786ab302, type: 3}
  colors: 0200000003000000
  flavorRequirement: 6
  favoriteBeverage: {fileID: 11400000, guid: c0081eeabe166a048bd6349085beb227, type: 2}
  openingDialogues:
  - speakerName: Ione
    line: '

      ...Sorry about not to order that quickly.I just...a bit tired,but<color
      = blue>I don''t know who to talk to about</color>.'
    optionTexts:
    - You alright?
    - I'm listening.
    nextNodeIndex0: 1
    nextNodeIndex1: 1
  - speakerName: Ione
    line: I have been living alone for a long time now, and I don't want my family
      to think that 'girls can only rely on others'. I have to rely on my own strength
      to survive, but<color=yellow> the life has been crushing me.</color>
    optionTexts:
    - I understand.
    - Just relax.
    nextNodeIndex0: 2
    nextNodeIndex1: 2
  - speakerName: Ione
    line: ...could you give me a cup with a <i>low alcohol content and more bubbles,
      a bit sour.</i> I don't want to get drunk. I have to work tomorrow.
    optionTexts:
    - Sure.
    - Please wait on.
    nextNodeIndex0: 3
    nextNodeIndex1: 3
  satisfiedDialogue:
    speakerName: Ione
    line: Oh, wow. After drinking this cup, I seem to have regained my energy. Cool!
    optionTexts:
    - Wonderful!
    - Anything else I can do for you?
    nextNodeIndex0: -1
    nextNodeIndex1: -1
  dissatisfiedDialogue:
    speakerName: Ione
    line: Well, it's not great... I feel a bit dizzy. I may need to rest for a while.
    optionTexts:
    - Sorry for that...
    - Anything else I can do for you?
    nextNodeIndex0: -1
    nextNodeIndex1: -1
  refillDialogue:
    speakerName: Ione
    line: I think I might have another drink...
    optionTexts:
    - Cool.
    - It'll be right out.
    nextNodeIndex0: -1
    nextNodeIndex1: -1
  checkoutDialogue:
    speakerName: 
    line: I think that's all I need for today. Thanks!
    optionTexts:
    - Thank you for your custom.
    - Have a nice day!
    nextNodeIndex0: -1
    nextNodeIndex1: -1
