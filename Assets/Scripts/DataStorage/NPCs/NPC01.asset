  flavorRequirement: 0
  dialogues:
  - speakerName: Alano
    line: "Hey, you're here. \nToday is your first day at work, so there are a few
      things I need to mention to you beforehand..."
    hasOptions: 0
    optionTexts: []
    nextNodeIndex0: 1
    nextNodeIndex1: 0
  - speakerName: Alano
    line: This place is Nocturne Club, where customers come seeking emotional support.
      This is exactly what attracts our guests.
    hasOptions: 0
    optionTexts: []
    nextNodeIndex0: 2
    nextNodeIndex1: 0
  - speakerName: Alano
    line: You need to observe their moods and adjust the drinks according to their
      words. The bartending instructions have been written in the brochure.
    hasOptions: 0
    optionTexts: []
    nextNodeIndex0: 3
    nextNodeIndex1: 0
  - speakerName: Alano
    line: 'Remember, mood is the key to serving the right drink.  Alright, start
      your work! '
    hasOptions: 1
    optionTexts:
    - Got it!
    - Let's start!
    nextNodeIndex0: -1
    nextNodeIndex1: -1
